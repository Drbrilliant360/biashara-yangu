{
  "name": "biashara-yangu-ios",
  "version": "1.0.0",
  "private": true,
  "description": "iOS (Capacitor) wrapper for the Biashara Yangu web app — App Store compliant build",
  "scripts": {
    "build:web": "cd .. && vite build --mode native --outDir mobile-ios/www --emptyOutDir",
    "sync": "npm run build:web && cap sync ios",
    "assets": "capacitor-assets generate --ios --iconBackgroundColor '#FFFFFF' --splashBackgroundColor '#FFFFFF'",
    "open": "cap open ios",
    "run:sim": "npm run sync && cap run ios"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/ios": "^7.6.10",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.10"
  }
}
